#!/usr/bin/env bash
# Format and lint check for staged conductor TypeScript. Enabled by `bun install`
# (package.json "prepare" sets core.hooksPath to .githooks).
#
# Checks the working-tree copy of each staged file, so a partially staged file is judged on
# what is on disk. Fix with: bun run fmt && bun run lint
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -t files < <(git diff --cached --name-only --diff-filter=ACMR -- 'conductor/*.ts')
[[ ${#files[@]} -gt 0 ]] || exit 0

if [[ ! -x node_modules/.bin/oxfmt || ! -x node_modules/.bin/oxlint ]]; then
  echo "pre-commit: oxfmt/oxlint missing; run bun install" >&2
  exit 1
fi

status=0
node_modules/.bin/oxfmt --check "${files[@]}" || status=1
node_modules/.bin/oxlint --deny-warnings "${files[@]}" || status=1
if [[ $status -ne 0 ]]; then
  echo "pre-commit: fix with 'bun run fmt && bun run lint', re-stage, and commit again" >&2
fi
exit $status
