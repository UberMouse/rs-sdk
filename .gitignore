node_modules/
__pycache__/
.DS_Store
runs/
screenshots/
public-bot/
public-client/

server.json
.env

backups/
.obsidian/

# Bot folders (except template)
bots/*/
!bots/_template/

# Daemon type checker temp file
sdk/__exec_check.ts

# Upstream npm lockfile; this repo builds the engine with bun/bun.lock only.
# Deleted locally — ignore so vendor syncs don't silently reintroduce it.
server/engine/package-lock.json

# SDK is copied into Docker via Dockerfile; don't duplicate it under server/
server/sdk/
jobs/
# Remote 25-account Lite fleet tooling (lives on the exedev host, not tracked here)
bots/FLEET_MANDATE.md
bots/camp_trainer.ts
bots/fleet_*.ts
bots/*_fleet.sh
bots/*_fleet_monitor.sh
bots/run_*_combat.sh
bots/combat_status.sh
bots/rs-sdk-remote.cron

# Durable Grand Exchange ledger and SQLite WAL files
server/engine/data/market.sqlite*

# Generated when engine utilities are invoked from the repository root
/data/

# --- local additions (not upstream) ---
# Upstream ignores every bot folder; we track ours. bot.env holds the
# account password, so it stays untracked (the template's has placeholders).
!bots/*/
bots/*/bot.env
!bots/_template/bot.env
# nix-direnv cache for the dev shell
.direnv/
