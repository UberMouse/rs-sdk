{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    // A plan imports `@conductor/lib/plan` and `@conductor/tasks/<task>` alike from conductor/plans/
    // and from a draft under conductor/runs/<bot>/plans/, so promoting it is a move (conductor/docs/plans.md).
    "paths": { "@conductor/*": ["./conductor/*"] },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["*.ts", "server/gateway/**/*.ts", "sdk/**/*.ts", "conductor/**/*.ts"],
  "exclude": ["server/engine", "server/webclient", "node_modules"]
}
